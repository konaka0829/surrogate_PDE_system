{
  "schema_version": "pol-study-v3",
  "output_root": "outputs/studies",
  "artifact_root": "artifacts",
  "profile": "smoke",
  "dataset_spec": "configs/datasets/burgers_smoke.json",
  "selection": {
    "metric": "validation_field_relative_l2_mean",
    "tie_tolerance": 1e-12,
    "tie_break": "first_in_config_order",
    "representative_readout": "affine",
    "freeze_before_test": true
  },
  "execution": {
    "torch_threads": 1,
    "batch_size": 3,
    "invalid_trial_policy": "error",
    "cache_states": true,
    "generate_plots": true
  },
  "name": "input_simulation_resolution",
  "base_trial": {
    "input": {
      "n_tar": 16,
      "resampling": "spectral"
    },
    "feature": {
      "kind": "pde_dynamics",
      "evolution": {
        "system": {
          "kind": "burgers",
          "nu": 0.01,
          "advection_coefficient": 1.0,
          "solver": "split_step",
          "dt": 0.01,
          "fine_dt": 0.005,
          "dealias": true
        },
        "time": 0.01
      },
      "n_sur": 16,
      "observation": {
        "kind": "equispaced_points",
        "J": 8,
        "l2_scale": true
      }
    },
    "output": {
      "kind": "real_fourier",
      "q": 9
    },
    "readouts": [
      {
        "id": "direct",
        "kind": "direct_fourier_decoder",
        "display_name": "Model 1"
      },
      {
        "id": "affine",
        "kind": "affine_ridge",
        "display_name": "Model 2",
        "zetas": [
          0.0,
          1e-12,
          1e-08
        ],
        "tie_tolerance": 1e-12,
        "tie_break": "largest_zeta",
        "svd_rcond": null
      },
      {
        "id": "random",
        "kind": "random_feature_ridge",
        "display_name": "Model 3",
        "activation": "tanh",
        "widths": [
          4
        ],
        "weight_scales": [
          0.5
        ],
        "bias_scales": [
          0.1
        ],
        "selection_seeds": [
          101,
          102
        ],
        "evaluation_seeds": [
          201,
          202
        ],
        "zetas": [
          0.0,
          1e-08
        ],
        "tie_tolerance": 1e-12,
        "svd_rcond": null
      }
    ]
  },
  "variants": [
    {
      "id": "burgers",
      "display_name": "Burgers feature generator",
      "selection_source": {
        "kind": "completed_study_selection",
        "source_study_spec": "studies/surrogate_parameter_time_landscape_smoke.json",
        "source_variant_id": "burgers",
        "source_readout_id": "affine",
        "import_paths": [
          "feature.evolution.system",
          "feature.evolution.time"
        ]
      },
      "overrides": {},
      "search": {
        "kind": "static"
      }
    },
    {
      "id": "reaction_diffusion",
      "display_name": "reaction-diffusion feature generator",
      "selection_source": {
        "kind": "completed_study_selection",
        "source_study_spec": "studies/surrogate_parameter_time_landscape_smoke.json",
        "source_variant_id": "reaction_diffusion",
        "source_readout_id": "affine",
        "import_paths": [
          "feature.evolution.system",
          "feature.evolution.time"
        ]
      },
      "overrides": {},
      "search": {
        "kind": "static"
      }
    }
  ],
  "global_axes": [
    {
      "path": "input.n_tar",
      "values": [
        9,
        16
      ]
    },
    {
      "path": "feature.n_sur",
      "values": [
        9,
        16
      ]
    }
  ],
  "reporters": [
    {
      "kind": "metric_map",
      "filename": "validation_input_simulation_resolution_burgers_direct",
      "x": "n_tar",
      "y": "n_sur",
      "x_values": [
        9,
        16
      ],
      "y_values": [
        9,
        16
      ],
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "readout_id": "direct",
      "variant_id": "burgers",
      "mark_selected": false,
      "formats": [
