{
  "schema_version": "pol-study-v4",
  "name": "dynamic_feature_baseline_comparison",
  "output_root": "outputs/studies",
  "artifact_root": "artifacts",
  "profile": "smoke",
  "dataset_spec": "configs/datasets/burgers_smoke.json",
  "base_trial": {
    "input": {"n_tar": 32, "resampling": "spectral"},
    "feature": {
      "kind": "pde_dynamics",
      "evolution": {
        "system": {
          "kind": "burgers",
          "nu": 0.01,
          "advection_coefficient": 1.0,
          "solver": "split_step",
          "dt": 0.01,
          "fine_dt": 0.0025,
          "dealias": true
        },
        "time": 0.02
      },
      "n_sur": 64,
      "observation": {
        "kind": "equispaced_points",
        "J": 16,
        "l2_scale": true
      }
    },
    "output": {"kind": "real_fourier", "q": 17},
    "readouts": [
      {
        "id": "direct",
        "kind": "direct_fourier_decoder",
        "display_name": "Model 1"
      },
      {
        "id": "affine",
        "kind": "affine_ridge",
        "display_name": "Model 2",
        "zetas": [0.0, 1e-12, 1e-8],
        "tie_tolerance": 1e-12,
        "tie_break": "largest_zeta",
        "svd_rcond": null
      },
      {
        "id": "random",
        "kind": "random_feature_ridge",
        "display_name": "Model 3",
        "activation": "tanh",
        "widths": [4],
        "weight_scales": [0.5],
        "bias_scales": [0.1],
        "selection_seeds": [101, 102],
        "evaluation_seeds": [201, 202],
        "zetas": [0.0, 1e-8],
        "tie_tolerance": 1e-12,
        "svd_rcond": null
      }
    ]
  },
  "variants": [
    {
      "id": "static_input",
      "display_name": "Static finite-input features",
      "overrides": {
        "feature.kind": "static_input",
        "feature.evolution": null
      },
      "search": {"kind": "static"}
    },
    {
      "id": "heat",
      "display_name": "Heat features",
      "selection_source": {
        "kind": "completed_study_selection",
        "source_study_spec": "studies/surrogate_parameter_time_landscape_smoke.json",
        "source_variant_id": "heat",
        "source_readout_id": "affine",
        "import_paths": [
          "feature.evolution.system",
          "feature.evolution.time"
        ]
      },
      "overrides": {},
      "search": {"kind": "static"}
    },
    {
      "id": "burgers",
      "display_name": "Burgers features",
      "selection_source": {
        "kind": "completed_study_selection",
        "source_study_spec": "studies/surrogate_parameter_time_landscape_smoke.json",
        "source_variant_id": "burgers",
        "source_readout_id": "affine",
        "import_paths": [
          "feature.evolution.system",
          "feature.evolution.time"
        ]
      },
      "overrides": {},
      "search": {"kind": "static"}
    },
    {
      "id": "reaction_diffusion",
      "display_name": "Reaction-diffusion features",
      "selection_source": {
        "kind": "completed_study_selection",
        "source_study_spec": "studies/surrogate_parameter_time_landscape_smoke.json",
        "source_variant_id": "reaction_diffusion",
        "source_readout_id": "affine",
        "import_paths": [
          "feature.evolution.system",
          "feature.evolution.time"
        ]
      },
      "overrides": {},
      "search": {"kind": "static"}
    }
  ],
  "comparison": {
    "kind": "dynamic_feature_baseline",
    "feature_families": {
      "static_input": "static_input",
      "heat": "heat",
      "burgers": "burgers",
      "reaction_diffusion": "reaction_diffusion"
    }
  },
  "global_axes": [],
  "selection": {
    "metric": "validation_field_relative_l2_mean",
    "tie_tolerance": 1e-12,
    "tie_break": "first_in_config_order",
    "representative_readout": "affine",
    "freeze_before_test": true
  },
  "convergence": {
    "sample_ids": [16, 11],
    "n_sur_candidates": [64, 128],
    "tolerances": {
      "terminal_mean": 0.5,
      "terminal_max": 0.7,
      "feature_mean": 0.5,
      "feature_max": 0.7,
      "prediction_mean": 0.5,
      "prediction_max": 0.7
    },
    "max_auto_reruns": 0
  },
  "diagnostics": [],
  "reporters": [],
  "execution": {
    "torch_threads": 1,
    "batch_size": 3,
    "invalid_trial_policy": "error",
    "cache_states": true,
    "generate_plots": false
  }
}
