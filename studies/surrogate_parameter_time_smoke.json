{
  "schema_version": "pol-study-v1",
  "name": "surrogate_parameter_time",
  "output_root": "outputs/studies",
  "artifact_root": "artifacts",
  "profile": "smoke",
  "dataset_spec": "configs/datasets/burgers_smoke.json",
  "base_trial": {
    "input": {
      "n_tar": 32,
      "resampling": "spectral"
    },
    "feature": {
      "kind": "pde_dynamics",
      "evolution": {
        "system": {
          "kind": "burgers",
          "nu": 0.01,
          "advection_coefficient": 1.0,
          "solver": "split_step",
          "dt": 0.01,
          "fine_dt": 0.005,
          "dealias": true
        },
        "time": 0.01
      },
      "n_sur": 64,
      "observation": {
        "kind": "equispaced_points",
        "J": 16,
        "l2_scale": true
      }
    },
    "output": {
      "kind": "real_fourier",
      "q": 17
    },
    "readouts": [
      {
        "id": "direct",
        "kind": "direct_fourier_decoder",
        "display_name": "Model 1"
      },
      {
        "id": "affine",
        "kind": "affine_ridge",
        "display_name": "Model 2",
        "zetas": [
          0.0,
          1e-12,
          1e-08
        ],
        "tie_tolerance": 1e-12,
        "tie_break": "largest_zeta",
        "svd_rcond": null
      },
      {
        "id": "random",
        "kind": "random_feature_ridge",
        "display_name": "Model 3",
        "activation": "tanh",
        "widths": [
          4
        ],
        "weight_scales": [
          0.5
        ],
        "bias_scales": [
          0.1
        ],
        "selection_seeds": [
          11,
          12
        ],
        "evaluation_seeds": [
          21,
          22
        ],
        "zetas": [
          0.0,
          1e-08
        ],
        "tie_tolerance": 1e-12,
        "svd_rcond": null
      }
    ]
  },
  "variants": [
    {
      "id": "burgers",
      "display_name": "Burgers feature generator",
      "overrides": {},
      "search": {
        "kind": "coordinate",
        "axes": [
          {
            "path": "feature.evolution.system.nu",
            "values": [
              0.005,
              0.01
            ],
            "anchor": 0.01
          },
          {
            "path": "feature.evolution.time",
            "values": [
              0.01,
              0.02
            ],
            "anchor": 0.01
          }
        ],
        "rounds": 0
      }
    },
    {
      "id": "reaction_diffusion",
      "display_name": "reaction-diffusion feature generator",
      "overrides": {
        "feature.evolution.system": {
          "kind": "reaction_diffusion",
          "nu": 0.01,
          "alpha": 1.0,
          "beta": 1.0,
          "solver": "semi_implicit_spectral_euler",
          "dt": 0.01,
          "nonlinear_filter": "two_thirds"
        }
      },
      "search": {
        "kind": "coordinate",
        "axes": [
          {
            "path": "feature.evolution.system.nu",
            "values": [
              0.005,
              0.01
            ],
            "anchor": 0.01
          },
          {
            "path": "feature.evolution.time",
            "values": [
              0.01,
              0.02
            ],
            "anchor": 0.01
          }
        ],
        "rounds": 0
      }
    }
  ],
  "selection": {
    "metric": "validation_field_relative_l2_mean",
    "tie_tolerance": 1e-12,
    "tie_break": "first_in_config_order",
    "representative_readout": "affine",
    "freeze_before_test": true
  },
  "convergence": {
    "sample_ids": [
      16,
      11
    ],
    "n_sur_candidates": [
      64,
      128
    ],
    "tolerances": {
      "terminal_mean": 0.5,
      "terminal_max": 0.7,
      "feature_mean": 0.5,
      "feature_max": 0.7,
      "prediction_mean": 0.5,
      "prediction_max": 0.7
    },
    "max_auto_reruns": 0
  },
  "diagnostics": [
    {
      "kind": "noise_robustness",
      "levels": [
        0.0,
        0.01
      ],
      "repeats": 2,
      "seed": 101
    }
  ],
  "reporters": [
    {
      "kind": "metric_curve",
      "filename": "validation_error_vs_surrogate_nu",
      "x": "feature_nu",
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "group_by": [
        "variant_id",
        "readout_id"
      ],
      "xscale": "log",
      "yscale": "log",
      "formats": [
        "png",
        "pdf"
      ],
      "dpi": 100
    },
    {
      "kind": "metric_curve",
      "filename": "validation_error_vs_readout_time",
      "x": "feature_time",
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "group_by": [
        "variant_id",
        "readout_id"
      ],
      "xscale": "linear",
      "yscale": "log",
      "formats": [
        "png"
      ],
      "dpi": 100
    }
  ],
  "execution": {
    "torch_threads": 1,
    "batch_size": 64,
    "invalid_trial_policy": "error",
    "cache_states": true,
    "generate_plots": true
  }
}
