{
  "schema_version": "pol-study-v1",
  "output_root": "outputs/studies",
  "artifact_root": "artifacts",
  "profile": "smoke",
  "dataset_spec": "configs/datasets/burgers_smoke.json",
  "selection": {
    "metric": "validation_field_relative_l2_mean",
    "tie_tolerance": 1e-12,
    "tie_break": "first_in_config_order",
    "representative_readout": "affine",
    "freeze_before_test": true
  },
  "execution": {
    "torch_threads": 1,
    "batch_size": 3,
    "invalid_trial_policy": "error",
    "cache_states": true,
    "generate_plots": true
  },
  "name": "finite_surrogate_resolution_map",
  "base_trial": {
    "input": {
      "n_tar": 32,
      "resampling": "spectral"
    },
    "feature": {
      "kind": "pde_dynamics",
      "evolution": {
        "system": {
          "kind": "burgers",
          "nu": 0.01,
          "advection_coefficient": 1.0,
          "solver": "split_step",
          "dt": 0.01,
          "fine_dt": 0.005,
          "dealias": true
        },
        "time": 0.01
      },
      "n_sur": 32,
      "observation": {
        "kind": "equispaced_points",
        "J": 8,
        "l2_scale": true
      }
    },
    "output": {
      "kind": "real_fourier",
      "q": 9
    },
    "readouts": [
      {
        "id": "affine",
        "kind": "affine_ridge",
        "display_name": "Model 2",
        "zetas": [
          0.0,
          1e-12,
          1e-08
        ],
        "tie_tolerance": 1e-12,
        "tie_break": "largest_zeta",
        "svd_rcond": null
      }
    ]
  },
  "variants": [
    {
      "id": "burgers",
      "display_name": "Burgers feature generator",
      "overrides": {},
      "search": {
        "kind": "static"
      }
    }
  ],
  "global_axes": [
    {
      "path": "input.n_tar",
      "values": [
        16,
        32
      ]
    },
    {
      "path": "feature.n_sur",
      "values": [
        16,
        32
      ]
    }
  ],
  "reporters": [
    {
      "kind": "resolution_map",
      "filename": "validation_finite_surrogate_resolution_map",
      "x": "n_tar",
      "y": "n_sur",
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "readout_id": "affine",
      "formats": [
        "png",
        "pdf"
      ],
      "dpi": 100
    }
  ]
}
