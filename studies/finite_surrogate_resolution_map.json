{
  "schema_version": "pol-study-v1",
  "output_root": "outputs/studies",
  "artifact_root": "artifacts",
  "profile": "main",
  "dataset_spec": "configs/datasets/burgers_main.json",
  "selection": {
    "metric": "validation_field_relative_l2_mean",
    "tie_tolerance": 1e-08,
    "tie_break": "first_in_config_order",
    "representative_readout": "affine",
    "freeze_before_test": true
  },
  "execution": {
    "torch_threads": 1,
    "batch_size": 64,
    "invalid_trial_policy": "error",
    "cache_states": true,
    "generate_plots": true
  },
  "name": "finite_surrogate_resolution_map",
  "base_trial": {
    "input": {
      "n_tar": 512,
      "resampling": "spectral"
    },
    "feature": {
      "kind": "pde_dynamics",
      "evolution": {
        "system": {
          "kind": "burgers",
          "nu": 0.01,
          "advection_coefficient": 1.0,
          "solver": "split_step",
          "dt": 0.01,
          "fine_dt": 0.001,
          "dealias": true
        },
        "time": 1.0
      },
      "n_sur": 512,
      "observation": {
        "kind": "equispaced_points",
        "J": 64,
        "l2_scale": true
      }
    },
    "output": {
      "kind": "real_fourier",
      "q": 33
    },
    "readouts": [
      {
        "id": "affine",
        "kind": "affine_ridge",
        "display_name": "Model 2",
        "zetas": [
          0.0,
          1e-12,
          1e-10,
          1e-08,
          1e-06,
          0.0001
        ],
        "tie_tolerance": 1e-10,
        "tie_break": "largest_zeta",
        "svd_rcond": null
      },
      {
        "id": "random",
        "kind": "random_feature_ridge",
        "display_name": "Model 3",
        "activation": "tanh",
        "widths": [
          128,
          256,
          512
        ],
        "weight_scales": [
          0.25,
          0.5,
          1.0
        ],
        "bias_scales": [
          0.0,
          0.1
        ],
        "selection_seeds": [
          101,
          102,
          103,
          104,
          105
        ],
        "evaluation_seeds": [
          201,
          202,
          203,
          204,
          205,
          206,
          207,
          208,
          209,
          210
        ],
        "zetas": [
          0.0,
          1e-12,
          1e-10,
          1e-08,
          1e-06,
          0.0001
        ],
        "tie_tolerance": 1e-10,
        "svd_rcond": null
      }
    ]
  },
  "variants": [
    {
      "id": "burgers",
      "display_name": "Burgers feature generator",
      "overrides": {},
      "search": {
        "kind": "static"
      }
    },
    {
      "id": "reaction_diffusion",
      "display_name": "reaction-diffusion feature generator",
      "overrides": {
        "feature.evolution.system": {
          "kind": "reaction_diffusion",
          "nu": 0.01,
          "alpha": 1.0,
          "beta": 1.0,
          "solver": "semi_implicit_spectral_euler",
          "dt": 0.01,
          "nonlinear_filter": "two_thirds"
        }
      },
      "search": {
        "kind": "static"
      }
    }
  ],
  "global_axes": [
    {
      "path": "input.n_tar",
      "values": [
        64,
        128,
        256,
        512
      ]
    },
    {
      "path": "feature.n_sur",
      "values": [
        64,
        128,
        256,
        512
      ]
    }
  ],
  "reporters": [
    {
      "kind": "resolution_map",
      "filename": "validation_finite_surrogate_resolution_map_affine",
      "x": "n_tar",
      "y": "n_sur",
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "readout_id": "affine",
      "formats": [
        "png",
        "pdf"
      ],
      "dpi": 120
    },
    {
      "kind": "resolution_map",
      "filename": "validation_finite_surrogate_resolution_map_random",
      "x": "n_tar",
      "y": "n_sur",
      "metric": "validation_field_relative_l2_mean",
      "split": "validation",
      "readout_id": "random",
      "formats": [
        "png",
        "pdf"
      ],
      "dpi": 120
    }
  ]
}
