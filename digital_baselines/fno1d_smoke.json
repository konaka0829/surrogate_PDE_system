{
  "schema_version": "pol-digital-baseline-v3",
  "name": "fno1d_burgers",
  "profile": "smoke",
  "output_root": "outputs/digital_baselines",
  "dataset_spec": "configs/datasets/burgers_smoke.json",
  "input": {
    "n_tar": 32,
    "resampling": "spectral"
  },
  "output": {
    "kind": "real_fourier",
    "q": 17
  },
  "model": {
    "kind": "fno1d",
    "activation": "gelu",
    "coordinate_channel": "none",
    "candidates": [
      {
        "id": "tiny_m4_w4_d1",
        "modes": 4,
        "width": 4,
        "depth": 1
      },
      {
        "id": "tiny_m6_w6_d2",
        "modes": 6,
        "width": 6,
        "depth": 2
      }
    ]
  },
  "normalization": {
    "kind": "train_standard_score",
    "epsilon": 1e-12
  },
  "training": {
    "optimizer": {
      "kind": "adam",
      "learning_rate": 0.001,
      "weight_decay": 0.0
    },
    "epochs": 2,
    "batch_size": 8,
    "selection_seeds": [701, 702],
    "evaluation_seeds": [801, 802, 803],
    "checkpoint_metric": "validation_field_relative_l2_mean",
    "checkpoint_tie_tolerance": 1e-12,
    "candidate_tie_tolerance": 1e-12,
    "candidate_tie_break": "first_in_config_order"
  },
  "physical_comparison": {
    "source_study_spec": "studies/dynamic_feature_baseline_comparison_smoke.json",
    "rows": [
      {"id": "static_direct", "label": "Static / Model 1", "variant_id": "static_input", "readout_id": "direct"},
      {"id": "static_affine", "label": "Static / Model 2", "variant_id": "static_input", "readout_id": "affine"},
      {"id": "static_random", "label": "Static / Model 3", "variant_id": "static_input", "readout_id": "random"},
      {"id": "heat_direct", "label": "Heat / Model 1", "variant_id": "heat", "readout_id": "direct"},
      {"id": "heat_affine", "label": "Heat / Model 2", "variant_id": "heat", "readout_id": "affine"},
      {"id": "heat_random", "label": "Heat / Model 3", "variant_id": "heat", "readout_id": "random"},
      {"id": "burgers_direct", "label": "Burgers / Model 1", "variant_id": "burgers", "readout_id": "direct"},
      {"id": "burgers_affine", "label": "Burgers / Model 2", "variant_id": "burgers", "readout_id": "affine"},
      {"id": "burgers_random", "label": "Burgers / Model 3", "variant_id": "burgers", "readout_id": "random"},
      {"id": "reaction_diffusion_direct", "label": "Reaction-diffusion / Model 1", "variant_id": "reaction_diffusion", "readout_id": "direct"},
      {"id": "reaction_diffusion_affine", "label": "Reaction-diffusion / Model 2", "variant_id": "reaction_diffusion", "readout_id": "affine"},
      {"id": "reaction_diffusion_random", "label": "Reaction-diffusion / Model 3", "variant_id": "reaction_diffusion", "readout_id": "random"}
    ]
  },
  "reporting": {
    "primary_result": "independent_training_seed_metric_summary",
    "confidence_level": 0.95,
    "confidence_interval_method": "student_t",
    "prediction_ensemble": "separate_table",
    "wall_clock_energy_comparison": "only_same_measurement_protocol"
  },
  "execution": {
    "device": "cpu",
    "torch_threads": 1
  }
}
