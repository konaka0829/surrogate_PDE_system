{
  "schema_version": "pol-dataset-v2",
  "name": "heat_reference_main",
  "artifact_root": "artifacts",
  "validation_spec": "configs/validation/foundation_main.json",
  "binding": {
    "kind": "foundation_only",
    "reason": "Reuse the passing initial-condition foundation only; Burgers reference convergence does not validate the heat target."
  },
  "reference_nx": 4096,
  "target": {
    "system": {
      "kind": "heat",
      "nu": 0.01
    },
    "time": 0.01
  },
  "batch_size": 20
}
